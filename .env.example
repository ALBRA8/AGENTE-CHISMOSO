# CHISMOSO environment variables (rename to .env and fill in)

# SQLite DB path
CHISMOSO_DB_PATH=/home/z/my-project/chismoso/data/chismoso.db

# Log level: DEBUG | INFO | WARN | ERROR
CHISMOSO_LOG_LEVEL=INFO

# Default geography for investigations
CHISMOSO_GEOGRAPHY=Colombia

# Where to save reports (markdown + JSON)
CHISMOSO_OUTPUT_DIR=/home/z/my-project/download/chismoso

# Next.js database (used by Prisma — not used by CHISMOSO directly)
DATABASE_URL=file:/home/z/my-project/db/custom.db

# GitHub token (for pushing releases) — DO NOT COMMIT THIS
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
