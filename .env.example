# CHISMOSO environment variables (rename to .env and fill in)
#
# All paths are RELATIVE to the dashboard project root (where this .env
# lives). Use forward slashes on every platform — Node.js resolves them
# correctly on Windows too. Override the absolute prefix at runtime with
# the CHISMOSO_DASHBOARD_ROOT env var if you deploy CHISMOSO outside the
# repo layout.

# SQLite DB path. Default: chismoso/data/chismoso.db (relative to the
# dashboard root). Override with an absolute path for Docker / systemd.
CHISMOSO_DB_PATH=chismoso/data/chismoso.db

# Log level: DEBUG | INFO | WARN | ERROR
CHISMOSO_LOG_LEVEL=INFO

# Default geography for investigations
CHISMOSO_GEOGRAPHY=Colombia

# Where to save reports (markdown + JSON). Default: download/chismoso
# (relative to the dashboard root).
CHISMOSO_OUTPUT_DIR=download/chismoso

# Next.js database (used by Prisma — not used by CHISMOSO directly).
# Default: db/custom.db (relative to the dashboard root).
DATABASE_URL=file:db/custom.db

# External search providers — configure at least ONE of these to use
# CHISMOSO without the z-ai-web-dev-sdk:
#   SERPER_API_KEY=...
#   TAVILY_API_KEY=...
#   BRAVE_API_KEY=...

# External LLM providers — configure at least ONE of these to use the
# chat / investigate / react commands without z-ai-web-dev-sdk:
#   NVIDIA_API_KEY=...
#   GROQ_API_KEY=...
#   OPENAI_API_KEY=...
# Optional overrides:
#   AI_BASE_URL=https://api.groq.com/openai/v1
#   AI_MODEL=openai/gpt-oss-120b

# GitHub token (for pushing releases) — DO NOT COMMIT THIS
# GITHUB_TOKEN=[REDACTED:github_token]
