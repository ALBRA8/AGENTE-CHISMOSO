# =============================================================================
# CHISMOSO environment variables (rename to .env and fill in)
#
# All paths are RELATIVE to the dashboard project root (where this .env
# lives). Use forward slashes on every platform — Node.js resolves them
# correctly on Windows too. Override the absolute prefix at runtime with
# the CHISMOSO_DASHBOARD_ROOT env var if you deploy CHISMOSO outside the
# repo layout.
#
# Quickstart: configure at least ONE search provider AND ONE LLM provider
# below. The z-ai-web-dev-sdk is loaded as a fallback ONLY when no
# external provider keys are set — see chismoso/src/providers/zai-loader.ts.
# =============================================================================

# -----------------------------------------------------------------------------
# Paths & runtime
# -----------------------------------------------------------------------------

# SQLite DB path. Default: chismoso/data/chismoso.db (relative to the
# dashboard root). Override with an absolute path for Docker / systemd.
CHISMOSO_DB_PATH=chismoso/data/chismoso.db

# Where to save reports (markdown + JSON). Default: download/chismoso
# (relative to the dashboard root).
CHISMOSO_OUTPUT_DIR=download/chismoso

# Default geography for investigations
CHISMOSO_GEOGRAPHY=Colombia

# Log level: DEBUG | INFO | WARN | ERROR
CHISMOSO_LOG_LEVEL=INFO

# Override the dashboard root used by the chismoso CLI for path resolution
# (defaults to process.cwd()). Set this only when the CLI runs from a
# different working directory than the Next.js app.
# CHISMOSO_DASHBOARD_ROOT=

# Override the chismoso/ source root (defaults to <dashboard>/chismoso).
# CHISMOSO_ROOT=

# -----------------------------------------------------------------------------
# LLM Provider (choose one — leave the others blank)
# -----------------------------------------------------------------------------

GROQ_API_KEY=
NVIDIA_API_KEY=
OPENAI_API_KEY=

# Optional model + base URL overrides (auto-detected per provider if unset):
#   Groq    -> https://api.groq.com/openai/v1   model: openai/gpt-oss-120b
#   NVIDIA  -> https://integrate.api.nvidia.com/v1  model: z-ai/glm-5.3-flash
# AI_BASE_URL=
# AI_MODEL=

# -----------------------------------------------------------------------------
# Search Provider (choose one — leave the others blank)
# -----------------------------------------------------------------------------

SERPER_API_KEY=
TAVILY_API_KEY=
BRAVE_API_KEY=

# -----------------------------------------------------------------------------
# Auth (dashboard + protected API routes)
# -----------------------------------------------------------------------------

# Set CHISMOSO_AUTH_ENABLED=true to require a Bearer token on protected
# routes (provider-settings, signals-config, telegram, whatsapp proxy).
# In production (NODE_ENV=production) auth is ON by default — set this to
# 'false' ONLY for emergency testing.
CHISMOSO_AUTH_ENABLED=false

# Secret used to sign JWT sessions. Generate one with:
#   openssl rand -hex 32
# Required when CHISMOSO_AUTH_ENABLED=true.
CHISMOSO_JWT_SECRET=

# -----------------------------------------------------------------------------
# CORS (dashboard API)
# -----------------------------------------------------------------------------

# Comma-separated list of allowed origins for browser fetches to /api/*.
# Default permits the local dashboard only.
CHISMOSO_CORS_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# Next.js database (Prisma — used by the dashboard only, NOT by CHISMOSO)
# -----------------------------------------------------------------------------

DATABASE_URL=file:db/custom.db

# -----------------------------------------------------------------------------
# Optional integrations
# -----------------------------------------------------------------------------

# WhatsApp daemon mini-service URL (used by the whatsapp daemon-proxy route
# when a separate whatsapp-daemon service is running). Leave blank to
# disable the WhatsApp proxy.
WHATSAPP_DAEMON_URL=

# Telegram bot token for the /api/telegram route (send + receive alerts).
# Leave blank to disable Telegram notifications.
TELEGRAM_BOT_TOKEN=

# Sentry DSN for error tracking. Leave blank to disable Sentry.
SENTRY_DSN=

# Public CHISMOSO domain — used by Caddy in docker-compose.chismoso.yml to
# request a Let's Encrypt cert. Defaults to localhost for local dev.
CHISMOSO_DOMAIN=localhost

# -----------------------------------------------------------------------------
# DO NOT COMMIT real values for any of the above.
# .env* is gitignored — only this .env.example is tracked.
# -----------------------------------------------------------------------------
