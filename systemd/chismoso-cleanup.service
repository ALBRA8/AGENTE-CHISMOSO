[Unit]
Description=CHISMOSO nightly reports cleanup
Documentation=https://github.com/chismoso/chismoso
After=chismoso.service

[Service]
Type=oneshot
User=chismoso
Group=chismoso

EnvironmentFile=/opt/chismoso/.env.production

ExecStart=/opt/chismoso/scripts/cleanup-reports.sh

TimeoutStartSec=120

StandardOutput=journal
StandardError=journal
SyslogIdentifier=chismoso-cron-cleanup

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/opt/chismoso/download /var/log/chismoso
